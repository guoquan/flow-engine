{
  "name": "@guoquan/flow-engine",
  "version": "0.1.10",
  "description": "A high-performance, WebGPU-based digital human engine.",
  "type": "module",
  "main": "./dist/flow.umd.js",
  "module": "./dist/flow.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:demo": "tsc && cross-env BUILD_DEMO=true vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview --host",
    "prepare": "npm run build",
    "mcp": "tsx src/mcp/server.ts",
    "docs:generate": "typedoc"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "^1.9.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.3",
    "@types/three": "^0.182.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.16",
    "cross-env": "^10.1.0",
    "jsdom": "^27.4.0",
    "three": "^0.182.0",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.15",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guoquan/flow-engine.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "ws": "8.18.3",
    "zod": "^4.3.5"
  }
}
